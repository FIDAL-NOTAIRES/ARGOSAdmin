{
  "crons": [
    { "path": "/api/ronde", "schedule": "0 3 * * *" }
  ],
  "functions": {
    "api/ronde.js": { "maxDuration": 60 },
    "api/admin.js": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
